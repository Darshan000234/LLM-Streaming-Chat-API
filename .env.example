# Copy this file to .env and add your private OpenRouter API key.
# Never put this key in public/app.js or commit .env to GitHub.
OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here

# 'openrouter/free' routes to an available free model when supported by your account.
# Replace with any model slug enabled for your OpenRouter account.
OPENROUTER_MODEL=openrouter/free
# Optional: set your deployed app URL if you publish this project.
OPENROUTER_SITE_URL=http://localhost:3000
PORT=3000
